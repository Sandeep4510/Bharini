# Copy this file to .env and replace placeholders with real local values.
DB_ENGINE=django.db.backends.postgresql
DB_NAME=bharini
DB_USER=bharini
DB_PASSWORD=***
DB_HOST=localhost
DB_PORT=5432

FRONTEND_URL=http://localhost:3000
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0, 10.0.2.2
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=true

EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtpout.secureserver.net
EMAIL_PORT=465
EMAIL_HOST_USER=admin@bharini.com
EMAIL_HOST_PASSWORD=***
DEFAULT_FROM_EMAIL=admin@bharini.com
EMAIL_USE_SSL=true
EMAIL_USE_TLS=false

AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_PATH=/api/v1/auth/
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax

# Production (AWS). Leave blank locally.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_CUSTOM_DOMAIN=
REDIS_URL=
